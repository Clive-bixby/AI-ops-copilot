# Copy to apps/api/.env and fill in the values you use locally.

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Datastores -----------------------------------------------------------
DATABASE_URL=postgres://aiops:aiops@localhost:5432/aiops
REDIS_URL=redis://localhost:6379

# Connection pool bounds. A managed Postgres with a low connection cap fails
# with "too many clients" when the pool is unbounded, and an idle client that
# the server drops must not take the process with it.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# Per-statement ceiling so one pathological query cannot hold a connection.
# Set to 0 to disable. Migrations opt out of it explicitly.
DB_STATEMENT_TIMEOUT_MS=30000

# --- Auth -----------------------------------------------------------------
# Required. The API refuses to mint tokens without it.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Answer generation (Gemini) -------------------------------------------
# Required for /ai/ask. Without it the endpoint returns an explicit provider
# error instead of an answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# --- Embeddings (Ollama) --------------------------------------------------
# Required for document ingestion and /ai/search.
# Run: ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Retrieval tuning -----------------------------------------------------
# Similarity floor is 0.65; lower values are clamped up to it.
AI_SEARCH_MIN_SIMILARITY=0.65
# Reciprocal rank fusion constant for the hybrid arm (default 60).
HYBRID_RRF_K=60
RAG_MIN_SIMILARITY=0.65
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=2200
RAG_MAX_OUTPUT_TOKENS=700

# --- Security -------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. When unset, local
# development allows the Vite ports and production allows no cross-origin calls.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Per-IP requests per minute for the whole API.
RATE_LIMIT_MAX=120
# Per-IP login/register attempts per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT=1mb
# Enables the /ai/test-* development routes (they still require auth + org).
ENABLE_DEV_ENDPOINTS=false
# Include the underlying dependency error in /ready responses. Off by default:
# the message can contain internal hostnames and ports.
HEALTH_DETAIL=false
# Set when behind a reverse proxy, e.g. 1 or "loopback", so rate limits key on
# the real client IP.
TRUST_PROXY=

# --- Database migrations --------------------------------------------------
# Run from apps/api:
#   npm run db:migrate     apply pending migrations
#   npm run db:baseline    record existing tables as already migrated (first
#                          run against a database created by the old
#                          schema.sql import)

# Connection TLS. Leave unset to infer from the URL (loopback -> off,
# remote -> on). The bundled docker-compose Postgres has TLS off.
DATABASE_SSL=

# Copy to .env at the repo root to override docker-compose defaults.

POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops
POSTGRES_DB=aiops

# Host ports published by compose. Change these if another local stack
# already uses 5432, 6379, 3000 or 4173.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
WEB_PORT=4173

# Local default in compose is a placeholder; change it before exposing the stack.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Required for /ai/ask.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Embeddings. ollama (default, runs on the host), openai-compatible (a hosted
# API that speaks POST /embeddings) or fixture (recorded vectors, no service).
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Ollama runs on the host machine.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Baked into the web bundle at build time; must be browser-reachable.
VITE_API_URL=http://localhost:3000

# Browser origins the API accepts, comma separated. Must include the web origin
# above; an empty value in production blocks all cross-origin browser calls.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Set when a reverse proxy or platform router sits in front of the API (e.g.
# 1 or "loopback"), so rate limits key on the real client IP. Leave empty when
# the API is reached directly.
TRUST_PROXY=

RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT=1mb
# Development-only /ai/test-* routes. Keep false outside local work.
ENABLE_DEV_ENDPOINTS=false
